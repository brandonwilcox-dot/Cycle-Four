; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cycle Four"
config/description="Idle-Miner / Tower Defense / Endless Wave hybrid. Three factions. Lore-first design."
config/version="0.1.0"
run/main_scene="res://scenes/Root.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/sprites/icon.svg"

[autoload]

EventBus="*res://src/autoloads/EventBus.gd"
GameState="*res://src/autoloads/GameState.gd"
EconomyManager="*res://src/autoloads/EconomyManager.gd"
WaveManager="*res://src/autoloads/WaveManager.gd"
FactionManager="*res://src/autoloads/FactionManager.gd"
GalaxyManager="*res://src/autoloads/GalaxyManager.gd"
SaveManager="*res://src/autoloads/SaveManager.gd"
ObjectiveManager="*res://src/autoloads/ObjectiveManager.gd"
ConvoyManager="*res://src/autoloads/ConvoyManager.gd"
MilestoneManager="*res://src/autoloads/MilestoneManager.gd"
SceneManager="*res://src/autoloads/SceneManager.gd"
Vfx="*res://src/vfx/Vfx.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

[editor]

script/search_in_files/suffixes=PackedStringArray("gd", "cs", "gdshader")

[filesystem]

import/blends/blender_path=""

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="units"
2d_physics/layer_3="projectiles"
2d_physics/layer_4="buildings"
2d_physics/layer_5="ancients"

[rendering]

environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
rendering/anti_aliasing/quality/msaa_3d=1
rendering/anti_aliasing/quality/screen_space_aa=2
rendering/anti_aliasing/quality/use_debanding=true
rendering/textures/default_filters/anisotropic_filtering_level=4
rendering/environment/glow/upscale_mode=1
rendering/environment/ssao/quality=3
rendering/environment/ssao/half_size=false
rendering/environment/ssao/fadeout_from=1600.0
rendering/environment/ssao/fadeout_to=3400.0
rendering/environment/ssil/quality=3
rendering/environment/ssil/half_size=false
rendering/environment/ssil/fadeout_from=1600.0
rendering/environment/ssil/fadeout_to=3600.0
rendering/environment/volumetric_fog/volume_size=96
rendering/environment/volumetric_fog/volume_depth=64
rendering/environment/volumetric_fog/use_filter=1
rendering/global_illumination/gi/use_half_resolution=false
rendering/global_illumination/sdfgi/probe_ray_count=2
rendering/global_illumination/sdfgi/frames_to_converge=5
rendering/global_illumination/sdfgi/frames_to_update_lights=3
rendering/lights_and_shadows/directional_shadow/size=8192
rendering/lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
